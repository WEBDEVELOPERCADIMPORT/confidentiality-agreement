---
import type { Lang } from '../../../i18n/config.i18n';
import agreementContent from '../../../data/site-agreement-content.json';

interface Props {
  lang: Lang;
  modalId?: string;
}

const { lang, modalId = 'signature-modal' } = Astro.props;
const t = (agreementContent[lang] ?? agreementContent.es).modal;
---

<div
  id={modalId}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${modalId}-title`}
  data-empty-error={t.emptyError}
>
  <div class="w-full max-w-xl bg-white border border-slate-200 rounded-xl shadow-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
      <h3 id={`${modalId}-title`} class="text-lg font-semibold text-slate-900">
        {t.title}
      </h3>
      <button
        type="button"
        data-signature-cancel
        class="text-slate-400 hover:text-slate-700 p-1 rounded-md transition-colors cursor-pointer"
        aria-label={t.cancelButton}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="p-6 space-y-4">
      <p class="text-sm text-slate-600">
        {t.instruction}
      </p>

      <div class="relative border-2 border-dashed border-slate-300 rounded-lg bg-slate-50 overflow-hidden">
        <canvas
          data-signature-canvas
          class="w-full h-52 block touch-none cursor-crosshair bg-white"
        ></canvas>
      </div>

      <p data-signature-error class="hidden text-xs font-medium text-red-600"></p>
    </div>

    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
      <button
        type="button"
        data-signature-clear
        class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer"
      >
        {t.clearButton}
      </button>

      <div class="flex items-center gap-3">
        <button
          type="button"
          data-signature-cancel
          class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors cursor-pointer"
        >
          {t.cancelButton}
        </button>
        <button
          type="button"
          data-signature-save
          class="px-5 py-2 text-sm font-semibold text-white bg-slate-900 rounded-lg hover:bg-slate-800 transition-colors cursor-pointer"
        >
          {t.saveButton}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupSignatureModal() {
    const modals = document.querySelectorAll<HTMLElement>('[data-empty-error]');
    modals.forEach((modal) => {
      if (modal.dataset.initialized === 'true') return;
      modal.dataset.initialized = 'true';

      const canvas = modal.querySelector<HTMLCanvasElement>('[data-signature-canvas]');
      const clearBtn = modal.querySelector<HTMLButtonElement>('[data-signature-clear]');
      const saveBtn = modal.querySelector<HTMLButtonElement>('[data-signature-save]');
      const cancelBtns = modal.querySelectorAll<HTMLButtonElement>('[data-signature-cancel]');
      const errorEl = modal.querySelector<HTMLElement>('[data-signature-error]');

      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let isDrawing = false;
      let hasDrawn = false;

      const resizeCanvas = () => {
        const rect = canvas.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        const dpr = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = Math.floor(rect.width * dpr);
        canvas.height = Math.floor(rect.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.2;
      };

      const clearCanvas = () => {
        const rect = canvas.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width || canvas.width, rect.height || canvas.height);
        hasDrawn = false;
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.classList.add('hidden');
        }
      };

      const getPoint = (e: PointerEvent) => {
        const rect = canvas.getBoundingClientRect();
        return {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top,
        };
      };

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      const openModal = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        requestAnimationFrame(() => {
          resizeCanvas();
          clearCanvas();
        });
      };

      modal.addEventListener('signature:open', openModal);

      canvas.addEventListener('pointerdown', (e: PointerEvent) => {
        e.preventDefault();
        canvas.setPointerCapture(e.pointerId);
        const { x, y } = getPoint(e);
        ctx.beginPath();
        ctx.moveTo(x, y);
        isDrawing = true;
        hasDrawn = true;
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.classList.add('hidden');
        }
      });

      canvas.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDrawing) return;
        e.preventDefault();
        const { x, y } = getPoint(e);
        ctx.lineTo(x, y);
        ctx.stroke();
      });

      const stopDrawing = () => {
        if (!isDrawing) return;
        isDrawing = false;
        ctx.closePath();
      };

      canvas.addEventListener('pointerup', stopDrawing);
      canvas.addEventListener('pointercancel', stopDrawing);

      clearBtn?.addEventListener('click', clearCanvas);

      cancelBtns.forEach((btn) => {
        btn.addEventListener('click', closeModal);
      });

      modal.addEventListener('click', (e: MouseEvent) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      saveBtn?.addEventListener('click', () => {
        if (!hasDrawn) {
          if (errorEl) {
            errorEl.textContent = modal.dataset.emptyError || 'Please draw your signature.';
            errorEl.classList.remove('hidden');
          }
          return;
        }
        const dataUrl = canvas.toDataURL('image/png');
        document.dispatchEvent(
          new CustomEvent('signature:saved', {
            detail: { dataUrl, modalId: modal.id },
          })
        );
        closeModal();
      });
    });
  }

  setupSignatureModal();
  document.addEventListener('astro:page-load', setupSignatureModal);
</script>
