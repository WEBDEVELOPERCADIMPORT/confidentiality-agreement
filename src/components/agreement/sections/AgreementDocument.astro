---
import type { Lang } from "../../../i18n/config.i18n";
import type { AgreementData } from "../../../actions/agreements/get-agreement-by-slug.action";
import agreementContent from "../../../data/site-agreement-content.json";

interface Props {
  agreement: AgreementData;
  lang: Lang;
}

const { agreement, lang } = Astro.props;
const t = agreementContent[lang] ?? agreementContent.en;
const { content, cadImport } = agreement;
---

<article
  class="bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden"
>
  <!-- Institutional Document Header -->
  <header
    class="px-6 sm:px-10 py-6 border-b border-slate-200 bg-slate-50/70 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <div class="flex items-center gap-4">
      <img
        src="/logo.png"
        alt={t.header.logoAlt}
        class="w-12 h-12 object-contain shrink-0"
      />
      <div>
        <p
          class="text-xs font-semibold tracking-widest uppercase text-slate-900"
        >
          {cadImport.company}
        </p>
        <p class="text-xs text-slate-500">{cadImport.jurisdiction}</p>
      </div>
    </div>

    <div class="flex items-center gap-3 self-start sm:self-auto">
      <span
        class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-slate-200/70 text-slate-700"
      >
        {t.header.documentBadge}
      </span>
    </div>
  </header>

  <!-- Legal Document Body -->
  <div class="px-6 sm:px-10 py-8 sm:py-10 space-y-8">
    <div class="text-center border-b border-slate-100 pb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {content.title}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-slate-600">
        {content.subtitle}
      </p>
    </div>

    <!-- Parties Summary -->
    <section
      aria-labelledby="parties-heading"
      class="bg-slate-50 border border-slate-200 rounded-lg p-5 space-y-3"
    >
      <h2
        id="parties-heading"
        class="text-xs font-semibold tracking-wider uppercase text-slate-500"
      >
        {t.document.partiesHeading}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700">
        <div>
          <p class="font-semibold text-slate-900">
            {content.parties.disclosingLabel}
          </p>
          <p class="mt-1 leading-relaxed">
            {content.parties.disclosingDetails}
          </p>
        </div>
        <div>
          <p class="font-semibold text-slate-900">
            {content.parties.receivingLabel}
          </p>
          <p class="mt-1 leading-relaxed">{content.parties.receivingDetails}</p>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <p class="text-sm sm:text-[15px] leading-relaxed text-slate-700">
      {content.intro}
    </p>

    <!-- Numbered Clauses -->
    <section aria-labelledby="clauses-heading" class="space-y-6 pt-2">
      <h2 id="clauses-heading" class="sr-only">
        {t.document.clausesHeading}
      </h2>

      {
        content.clauses.map((clause) => (
          <div class="space-y-1.5">
            <h3 class="text-base font-semibold text-slate-900">
              {clause.number}. {clause.title}
            </h3>
            <p class="text-sm sm:text-[15px] leading-relaxed text-slate-700">
              {clause.body}
            </p>
          </div>
        ))
      }
    </section>
  </div>
</article>
