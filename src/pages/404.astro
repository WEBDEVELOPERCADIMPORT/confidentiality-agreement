---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — CAD Import Inc." lang="en" minimal={true}>
  <section
    class="flex-1 flex flex-col justify-center items-center text-center px-6 py-16 bg-slate-50 text-slate-900"
  >
    <div class="w-full max-w-lg mx-auto flex flex-col items-center">
      <img
        src="/logo.png"
        alt="CAD Import Inc. Logo"
        class="w-24 h-24 object-contain mb-8 opacity-90"
      />

      <p
        class="text-xs font-semibold tracking-[0.22em] uppercase text-slate-500 mb-2"
      >
        CAD Import Inc.
      </p>

      <h1 class="text-6xl sm:text-7xl font-bold tracking-tight text-slate-900">
        404
      </h1>

      <p class="text-xl font-semibold text-slate-800 mt-4">Page not found</p>

      <p
        class="text-sm sm:text-base text-slate-600 mt-2 mb-8 max-w-md leading-relaxed"
      >
        The requested confidentiality agreement or page does not exist or is no
        longer available.
      </p>

      <a
        href="/en/"
        class="inline-flex items-center justify-center px-6 py-2.5 text-sm font-semibold text-white bg-slate-900 rounded-lg shadow-xs hover:bg-slate-800 transition-colors"
      >
        Return to portal
      </a>
    </div>
  </section>
</Layout>
